# The upstream Kanidm release these packages are built from.
# Keep in step with the server pin in invite-kanidm (images/kanidm-server/versions.env).
# Commit: git ls-remote https://github.com/kanidm/kanidm.git refs/tags/<tag>
KANIDM_TAG=v1.12.0
KANIDM_COMMIT=a52b723ce8efb1f4d0a6bc2a2c36b4071f95317d
# The tag's rust-version from its Cargo.toml.
RUST_VERSION=1.96
# Known good with Kanidm's own packaging (kanidm/kanidm_ppa_automation).
CARGO_DEB_VERSION=2.11.2
